---
const logoPath = '/path/to/ghsuites-logo.png'; // Cambia esta ruta al logo que has mencionado
const userIconPath = '/path/to/user-icon.png'; // Cambia esta ruta al icono de usuario
const notificationIconPath = '/path/to/notification-icon.png'; // Cambia esta ruta al icono de notificación

---

<style>
    @import '/public/styles/Header.css'; /* Importa el archivo CSS para estilos */
</style>

<header class="header">
    <div class="logo"><a href="http://localhost:4321/Inicio">
        <img src="/public/images/gehlogo.png" alt="GH Suites Logo" />
    </a>
    </div>
    <nav class="nav">
        <a href="http://localhost:4321/misreservas" class="reservations-link">Consultar mis reservas</a>
        <div class="icons">
            <div class="notification-icon">
              <img src="/public/images/notification_icon.png" alt="Notification Icon" />
                
                 <!-- Aquí podrías usar un icono SVG en lugar del emoji -->
            </div>
            <div class="user-icon">
                <img src="/public/images/genericavatar_icon.jpg" alt="User Icon" />
            </div>
        </div>
    </nav>
</header>
