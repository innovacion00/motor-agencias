---
// No se requiere lógica específica de Astro para este componente.
---

<nav class="navbar">
    <div class="navbar-container">
        <!-- Logo -->
        <a href="/" class="navbar-logo">
            <img src="https://www.gehsuites.com/images/geh_suites_logo_1_naranja.png" alt="Geh Suites Logo" />
        </a>
        
        <!-- Enlaces de navegación -->
        <ul class="navbar-menu">
            <li><a href="/">Inicio</a></li>
            <li><a href="/rooms">Habitaciones</a></li>
            <li><a href="/services">Servicios</a></li>
            <li><a href="/promotions">Promociones</a></li>
            <li><a href="/gallery">Galería</a></li>
            <li><a href="/location">Ubicación</a></li>
            <li><a href="/contact">Contacto</a></li>
        </ul>

        <!-- Selector de idioma -->
        <div class="navbar-language">
            <select name="language" id="language-select">
                <option value="es">ES</option>
                <option value="en">EN</option>
            </select>
        </div>

        <!-- Menú hamburguesa para móviles -->
        <div class="navbar-toggle" id="navbar-toggle">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
</nav>

<style>
    .navbar {
        background-color: #333; /* Cambia según el diseño real */
        color: #fff;
        padding: 10px 20px;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }

    .navbar-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .navbar-logo img {
        width: 150px; /* Ajusta el tamaño según sea necesario */
    }

    .navbar-menu {
        list-style: none;
        display: flex;
        margin: 0;
        padding: 0;
    }

    .navbar-menu li {
        margin-left: 20px;
    }

    .navbar-menu a {
        color: #fff;
        text-decoration: none;
        padding: 10px 15px;
        display: block;
    }

    .navbar-language {
        margin-left: 20px;
    }

    .navbar-language select {
        background-color: #333;
        color: #fff;
        border: none;
        padding: 5px;
        cursor: pointer;
    }

    .navbar-toggle {
        display: none; /* Se mostrará en pantallas más pequeñas */
        flex-direction: column;
        cursor: pointer;
    }

    .navbar-toggle span {
        width: 25px;
        height: 3px;
        background-color: #fff;
        margin: 4px;
    }

    @media (max-width: 768px) {
        .navbar-menu {
            display: none; /* Oculta el menú en pantallas pequeñas */
            flex-direction: column;
            position: absolute;
            top: 60px;
            right: 0;
            background-color: #333;
            width: 100%;
            padding: 20px;
        }

        .navbar-menu.show {
            display: flex; /* Muestra el menú cuando el toggle está activo */
        }

        .navbar-toggle {
            display: flex; /* Muestra el toggle en pantallas pequeñas */
        }
    }
</style>

<script>
    // Script para mostrar/ocultar el menú en dispositivos móviles
    document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('navbar-toggle');
        const menu = document.querySelector('.navbar-menu');

        toggle.addEventListener('click', () => {
            menu.classList.toggle('show');
        });
    });
</script>
