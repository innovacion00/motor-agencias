<html>
<head>
  <title>Portal Agencias</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&amp;display=swap" rel="stylesheet" />
</head>

<body>
  <div class="container">
    <div class="video-section">
      <video autoplay muted loop>
        <source src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/video%20landing%20agencias.mp4"
          type="video/mp4">
        Tu navegador no soporta la reproducción de videos.
      </video>
    </div>
    <div class="form-section">
      <div class="form-wrapper">
        <div class="form-container" id="login-form">
          <!-- Formulario de inicio de sesión -->
          <div class="logo">
            <a href="/">
              <img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/gehlogo.png" alt="Logo" width="150"
                height="50" />
            </a>
          </div>
          <div class="form-title">Portal de agencias</div>
          <div class="form-subtitle">Le damos la bienvenida al portal diseñado para las agencias de viajes.</div>
          <hr>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" placeholder="Escribe el correo" />
          </div>
          <div class="form-group password-input">
            <label for="password">Contraseña</label>
            <div class="input-wrapper">
              <input type="password" id="password" placeholder="Escribe la contraseña" />
              <i class="fas fa-eye toggle-password"></i>
            </div>
          </div>
          <a class="forgot-password" href="/recuperarcontrasena">Olvidé la contraseña</a>
          <div class="form-group terms">
            <input type="checkbox" id="terms" />
            <label for="terms">
              Acepto <a href="https://space-img.sfo3.digitaloceanspaces.com/Agencias/TerminosyCondiciones-BookingConnect.pdf" target="_blank" rel="noopener noreferrer"> términos y
                condiciones</a>
            </label>
          </div>
          <div class="form-group">
            <button class="submit-btn" id="submit-btn" disabled> Iniciar sesión</button>
          </div>


          <!-- Indicador de carga -->
          <div id="loading-indicator">
            <div class="spinner"></div>
            Procesando...
          </div>
        </div>

        <!-- Formulario de verificación de código -->
        <div class="form-container" id="verification-form" style="display: none;">
          <div class="form-title">Verificación de Código</div>
          <div class="form-group">
            <div class="form-subtitle2"> Si el correo ingresado está registrado, le llegara un codigo de verificación correo valido por 5 min. </div>            
            <label for="verification-code">Código de verificación</label>

            <input type="text" id="verification-code" placeholder="Ingrese el código recibido" />
          </div>
          <div class="form-group2">
            <button id="verify-btn">Verificar</button>
          </div>

          <!-- Indicador de carga -->
          <div id="loading-indicator">
            <div class="spinner"></div>
            Verificando...
          </div>
        </div>
        
      </div>
    </div>
  </div>
</body>

</html>
<script>
  // Función para verificar si los campos están llenos y el checkbox está marcado
  import Swal from 'sweetalert2'
  function validateForm() {
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value.trim();
    const termsAccepted = (document.getElementById('terms') as HTMLInputElement).checked;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    submitBtn.disabled = !(email && password && termsAccepted);
  }

  document.getElementById('email').addEventListener('input', validateForm);
  document.getElementById('password').addEventListener('input', validateForm);
  document.getElementById('terms').addEventListener('change', validateForm);

  document.querySelector('.toggle-password').addEventListener('click', function () {
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    this.classList.toggle('fa-eye-slash');
  });

  //Manejo inicio de sesion
  async function handleLogin() {
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value.trim();
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const loadingIndicator = document.getElementById('loading-indicator') as HTMLElement;

    //// Deshabilitar el botón de inicio de sesión para evitar múltiples clics
    submitBtn.disabled = true;
    loadingIndicator.style.display = 'block';


    try {
      const response = await fetch("https://gehsuitesapps.com/agencias/v1/auth/sign-in", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          email,
          password
        })
      });

      if (response.ok) {
        const data = await response.json();
        const token = data.token; // El servidor debe enviar el token en esta respuesta

        // Guardamos el token en localStorage para futuras solicitudes
        localStorage.setItem("authToken", token);

        // Cambiamos a la vista de verificación de OTP
        document.getElementById('login-form') !.style.display = 'none';
        document.getElementById('verification-form') !.style.display = 'block';
      } else {
        Swal.fire({
          icon: "error",
          title: "Oops...",
          text: "Datos de inicio de sesion incorrectos",
          showConfirmButton: false,
          timer: 4000
        });
      }
    } catch (error) {
      console.error("Error en el inicio de sesión:", error);
      Swal.fire({
        icon:"error",
        title:"Oops...",
        text:"Datos de inicio de sesion incorrectos",
        showConfirmButton:false,
        timer:4000
      })
    } finally {
      // Rehabilitar el botón en caso de error
      submitBtn.disabled = false;
      loadingIndicator.style.display = 'none';
    }
  }



  async function verifyCode() {
    const otp = (document.getElementById('verification-code') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value; // Usamos el mismo email
    const verifyBtn = document.getElementById('verify-btn') as HTMLButtonElement;
    const loadingIndicator = document.getElementById('loading-indicator') as HTMLElement;

    // Deshabilitar botón y mostrar el indicador de carga
    verifyBtn.disabled = true;
    loadingIndicator.style.display = 'block';

    try {
      const response = await fetch("https://gehsuitesapps.com/agencias/v1/auth/validate-otp", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          otp,
          email
        })
      });

      if (response.ok) {
        // Redirigir al usuario a la página de inicio
        window.location.href = "/inicio";
      } else {
        Swal.fire({
          icon: "error",
          title: "Oops...",
          text: "Codigo otp incorrecto. Verifique nuevamente",

        });
      }
    } catch (error) {
      console.error("Error en la verificación del código OTP:", error);
      alert("Ocurrió un error al verificar el código. Por favor, intente más tarde.");
    } finally {
      // Rehabilitar el botón y ocultar el indicador de carga
      verifyBtn.disabled = false;
      loadingIndicator.style.display = 'none';
    }
  }

  // Añadir el evento de click al botón de iniciar sesión
  document.getElementById('submit-btn').addEventListener('click', handleLogin);
  // Añadir el evento de click al botón de verificación de código OTP
  document.getElementById('verify-btn').addEventListener('click', verifyCode);
</script>


