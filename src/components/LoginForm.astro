    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .logo {
    text-align: left;
    margin-bottom: 20px;
  }

  .logo img {
    width: 170px;
    padding-bottom: 10px;
  }

  .form-title {
    font-size: 24px;
    font-weight: 700;
    color: #1C3D5A;
    margin-bottom: 10px;
    text-align: left;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
  }

  .form-subtitle {
    font-size: 16px;
    color: #1C3D5A;
    margin-bottom: 30px;
    text-align: left;
  }

  .form-group {
    margin-bottom: 20px;
    width: 100%;
  }

  .form-group label {
    display: block;
    font-size: 14px;
    color: #1C3D5A;
    margin-bottom: 5px;
    padding-top: 10px;
  }

  .form-group input {
    width: 100%;
    padding: 10px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    
  }

  .form-group .input-wrapper {
    position: relative;
    width: 100%;
  }

  .form-group .input-wrapper input {
    width: 100%;
    padding: 10px;
    padding-right: 9px; /* Espacio para el ícono */
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  
  

  .form-group .input-wrapper .toggle-password {
    position: absolute;
    right: 10px;
    top: 55%;
    transform: translateY(-50%);
    cursor: pointer;
  }

  
  .form-group .forgot-password a {
    align-content: right;
  }

  .form-container .forgot-password:hover {
    text-decoration: underline;
  }

  .form-container .terms {
    display:flex;
    align-items: center; /* Alinea verticalmente el checkbox y el texto */
}

  .form-container .terms a {
    color: #1C3D5A;
    text-decoration: none;
  }
  .form-container .terms a :hover{
    text-decoration: underline  ;
  }

  .form-container .terms input {
    margin-right: 1px; /* Espacio entre el checkbox y el texto */
    width: 10px;
    
}
 

  .form-group .submit-btn {
    width: 100%;
