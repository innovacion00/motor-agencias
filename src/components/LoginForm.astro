  }

  .form-container .forgot-password:hover {
    text-decoration: underline;
  }

  .form-container .terms {
    display:flex;
    align-items: center; /* Alinea verticalmente el checkbox y el texto */
}

  .form-container .terms a {
    color: #1C3D5A;
    text-decoration: underline;
  }
  .form-container .terms a :hover{
    text-decoration: underline  ;
  }

  .form-container .terms input {
    margin-right: 1px; /* Espacio entre el checkbox y el texto */
    width: 10px;
    
}
 

  .form-group .submit-btn {
    width: 100%;
    padding: 10px;
    font-size: 16px;
    color: white;
    background-color: #1C3D5A;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .form-group .submit-btn:hover {
    background-color: #004494;
  }

  hr {
    width: 100%;
    color: #CFCECE;
    opacity: 0.4;
  }

  .register h4{
 color: #1C3D5A;
 text-size-adjust: 14px;
 font-family: 'Roboto', sans-serif;
 
}
  
</style>
