  }

  .logo {
    padding-top: 15%;
    text-align: left;
    margin-bottom: 20px;
  }

  .logo img {
    width: 170px;
    padding-bottom: 10px;
  }

  .form-title {
    padding-top: 20px;
    font-size: 24px;
    font-weight: 700;
    color: #1C3D5A;
    margin-bottom: 10px;
    text-align: left;
    
  }

  .form-subtitle {
    font-size: 16px;
    color: #1C3D5A;
    margin-bottom: 30px;
    text-align: left;
  }

  .form-group {
    padding-top: 25px;
    margin-bottom: 20px;
    width: 100%;
  }

  .form-group label {
    padding-top: 10px;
    display: block;
    font-size: 14px;
    color: #1C3D5A;
    margin-bottom: 5px;
    padding-top: 10px;
  }

  .form-group input {
    width: 100%;
    padding: 10px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    
  }

  .form-group .input-wrapper {
    position: relative;
    width: 100%;
  }

  .form-group .input-wrapper input {
    width: 100%;
    padding: 10px;
    padding-right: 9px; /* Espacio para el ícono */
    font-size: 14px;
    border: 1px solid #ccc;
