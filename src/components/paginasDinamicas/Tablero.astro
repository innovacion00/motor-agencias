---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Userdashboard from "../Userdashboard.jsx";
import UserDashboardEventos from "../UserDashboardEventos.jsx";

const { modo } = Astro.props;
const titulo =
  modo === "usuario" ? "Mi perfil - BookingConnect" : "Tablero de eventos - BookingConnect";
---

<BaseLayout title={titulo}>
  {modo === "eventos" ? (
    <UserDashboardEventos client:load />
  ) : (
    <Userdashboard client:load />
  )}
</BaseLayout>