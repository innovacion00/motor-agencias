<script>
  import { checkSession } from "../stores/authtoken";
  
  class RouteProtection {
    static async init() {
      try {
        const isValidSession = await checkSession();
        if (!isValidSession) {
          window.location.href = '/login';
        }
      } catch (error) {
        console.error('Error validando sesión:', error);
        window.location.href = '/login';
      }
    }
  }

  RouteProtection.init();
</script>
