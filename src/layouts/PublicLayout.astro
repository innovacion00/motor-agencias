---
const { title } = Astro.props;
const ENABLE_VIEW_TRANSITIONS = true;
import Footer from '../components/Footer.astro';
import { ClientRouter } from "astro:transitions";
import "sweetalert2/dist/sweetalert2.min.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="https://www.gehsuites.com/favicon/favicon-32x32.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
    <style>
      .swal2-container {
        z-index: 20000;
      }

      .swal2-popup,
      .swal2-title,
      .swal2-html-container,
      .swal2-input,
      .swal2-textarea {
        color: #545454;
      }
    </style>
    {ENABLE_VIEW_TRANSITIONS && (
      <>
        <ClientRouter />
        <style>
          main {
            view-transition-name: page-content;
          }

          ::view-transition-old(page-content) {
            animation: 180ms ease-out both vt-fade-out;
          }

          ::view-transition-new(page-content) {
            animation: 260ms ease-out both vt-fade-slide-in;
          }

          @keyframes vt-fade-out {
            from {
              opacity: 1;
            }
            to {
              opacity: 0.3;
            }
          }

          @keyframes vt-fade-slide-in {
            from {
              opacity: 0;
              transform: translateY(8px);
            }
            to {
              opacity: 1;
              transform: translateY(0);
            }
          }

          @media (prefers-reduced-motion: reduce) {
            ::view-transition-old(page-content),
            ::view-transition-new(page-content) {
              animation: none;
            }
          }

          ::view-transition {
            pointer-events: none;
          }
        </style>
      </>
    )}
  </head>
  <body>
    <div class="wrapper">
      <!-- Header público simple sin autenticación -->
      <header style="background-color: white; color: #a87129; padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between;">
        <a href="https://www.gehsuites.com/es">
        <img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/gehlogo.png" alt="GH Suites Logo" style="height: 40px;" />
      </a>
        <div style="display: flex; flex-direction: column; align-items: center; flex: 1;">
          <h1 style="margin: 0; font-size: 1.5rem; color: #a87129; font-family: 'Roboto', sans-serif;">BookingConnect</h1>
          <p style="margin: 0.5rem 0 0 0; font-size: 0.9rem; color: #a87129; font-family: 'Roboto', sans-serif;">Cotización de reserva</p>
        </div>
        <div style="width: 40px;"></div>
      </header>
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import { cleanupSweetAlert } from "../utils/cleanupSweetAlert";

  document.addEventListener("astro:before-swap", () => {
    cleanupSweetAlert();
  });
</script>
