---
const { title } = Astro.props;
// Flag global fácil de apagar/encender
const ENABLE_VIEW_TRANSITIONS = true;
// import Header from '../components/Header.astro';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import CurrencySelector from '../components/Cambiardivisas';
import { ViewTransitions } from "astro:transitions";
import "sweetalert2/dist/sweetalert2.min.css";
// import CurrencySelector from '../components/Cambiardivisas';

---

<!DOCTYPE html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="https://www.gehsuites.com/favicon/favicon-32x32.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet"/>
    <style>
      /* SweetAlert2: z-index y texto (el body global usa color blanco) */
      .swal2-container {
        z-index: 20000;
      }

      .swal2-popup,
      .swal2-title,
      .swal2-html-container,
      .swal2-input,
      .swal2-textarea {
        color: #545454;
      }
    </style>
    {ENABLE_VIEW_TRANSITIONS && (
      <>
        <ViewTransitions />
        <style>
          main {
            view-transition-name: page-content;
          }

          ::view-transition-old(page-content) {
            animation: 180ms ease-out both vt-fade-out;
          }

          ::view-transition-new(page-content) {
            animation: 260ms ease-out both vt-fade-slide-in;
          }

          @keyframes vt-fade-out {
            from {
              opacity: 1;
            }
            to {
              opacity: 0.3;
            }
          }

          @keyframes vt-fade-slide-in {
            from {
              opacity: 0;
              transform: translateY(8px);
            }
            to {
              opacity: 1;
              transform: translateY(0);
            }
          }

          @media (prefers-reduced-motion: reduce) {
            ::view-transition-old(page-content),
            ::view-transition-new(page-content) {
              animation: none;
            }
          }

          /* Evita que capas de transición bloqueen clicks */
          ::view-transition {
            pointer-events: none;
          }
        </style>
      </>
    )}
  </head>
  <body>
    <div class="wrapper"> <!-- Añadido: contenedor flex -->
      <!-- <CurrencySelector client:load/> -->
      <CurrencySelector client:load/>
      <Header client:load />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
<script>
  import { cleanupSweetAlert } from "../utils/cleanupSweetAlert";

  document.addEventListener("astro:before-swap", () => {
    cleanupSweetAlert();
  });
</script>

