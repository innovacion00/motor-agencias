<html lang = "es">
  <head>
    <meta charset="UTF-8" />
    <title>Recuperar Contraseña</title>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="container">
      <div class="video-section">
        <video autoplay muted loop>
          <source
            src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/video%20landing%20agencias.mp4"
            type="video/mp4"
          />
          Tu navegador no soporta la reproducción de videos.
        </video>
      </div>
      <div class="form-section">
        <div class="form-wrapper">
          <div class="form-container" id="login-form">
            <!-- Formulario de inicio de sesión -->
            <div class="logo">
              <a href="/">
                <img
                  src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/gehlogo.png"
                  alt="Logo"
                  width="150"
                  height="50"
                />
              </a>
            </div>
            <div class="form-title">Portal de agencias</div>
            <div class="form-section">
              <div class="form-wrapper">
                <!-- Formulario de recuperación de contraseña -->
                <div id="request-code-form">
                  <h1>Recuperar Contraseña</h1>
                  <p>
                    Por favor, ingresa tu correo electrónico para enviar un
                    código de recuperación.
                  </p>
                  <hr />
                  <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <input
                      type="email"
                      id="email"
                      placeholder="Escribe tu correo"
                    />
                  </div>

                  <!-- Loading spinner -->

                  <div class="spinner-overlay" id="spinner-overlay">
                    <div class="spinner"></div>
                  </div>

                  <div class="form-group">
                    <button class="send-code-btn" id="send-code-btn"
                      >Enviar Código</button
                    >
                  </div>
                </div>

                <!-- Loading spinner -->

                <div class="spinner-overlay" id="spinner-overlay">
                  <div class="spinner"></div>
                </div>

                <div class="form-group">
                  <a href="/"
                    ><button class="return-login" id="send-code-btn"
                      >Volver al incio</button
                    ></a
                  >
                </div>
              </div>

              <!-- Formulario de verificación del código -->
              <div id="verify-code-form" style="display: none;">
                <h1>Verificar Código</h1>
                <p>Por favor, ingresa el código que se envió a tu correo.</p>
                <div class="form-group">
                  <label for="otp">Código de verificación</label>
                  <input type="text" id="otp" placeholder="Código recibido" />
                </div>
                <div class="form-group">
                  <button id="verify-btn">Verificar</button>
                </div>
              </div>

              <!-- Formulario para establecer nueva contraseña -->
              <div id="set-password-form" style="display: none;">
                <h1>Establecer Nueva Contraseña</h1>
                <div class="form-group">
                  <label for="new-password">Nueva contraseña</label>
                  <input
                    type="password"
                    id="new-password"
                    placeholder="Escribe la nueva contraseña"
                  />
                </div>
                <div class="form-group">
                  <label for="confirm-password">Confirmar contraseña</label>
                  <input
                    type="password"
                    id="confirm-password"
                    placeholder="Confirma la nueva contraseña"
                  />
                </div>
                <div class="form-group">
                  <button id="set-password-btn">Guardar Contraseña</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <script>
          import Swal from "sweetalert2";
          import { tokenglobal } from "../stores/authtoken";
          const sendCodeBtn = document.getElementById(
            "send-code-btn"
          ) as HTMLButtonElement;
          const verifyBtn = document.getElementById(
            "verify-btn"
          ) as HTMLButtonElement;
          const setPasswordBtn = document.getElementById(
            "set-password-btn"
          ) as HTMLButtonElement;

          const emailInput = document.getElementById(
            "email"
          ) as HTMLInputElement;
          const otpInput = document.getElementById("otp") as HTMLInputElement;
          const newPasswordInput = document.getElementById(
            "new-password"
          ) as HTMLInputElement;
          const confirmPasswordInput = document.getElementById(
            "confirm-password"
          ) as HTMLInputElement;

          const requestCodeForm = document.getElementById(
            "request-code-form"
          ) as HTMLElement;
          const verifyCodeForm = document.getElementById(
            "verify-code-form"
          ) as HTMLElement;
          const setPasswordForm = document.getElementById(
            "set-password-form"
          ) as HTMLElement;

          // --------------------Enviar código OTP al correo--------------------
          sendCodeBtn.addEventListener("click", async () => {
            const email = emailInput.value.trim();

            // Mostrar el spinner
            const showSpinner = () => {
              const spinner = document.getElementById("spinner-overlay");
              spinner.style.display = "flex";
            };

            // Ocultar el spinner
            const hideSpinner = () => {
              const spinner = document.getElementById("spinner-overlay");
              spinner.style.display = "none";
            };

            if (!email) {
              Swal.fire({
                icon: "error",
                title: "Algo salió mal...",
                text: "Porfavor ingresa tu correo electronico",
                showConfirmButton: false,
                timer: 2500,
              });
              return;
            }

            showSpinner(); //funcion mostrar spinner

            try {
              const response = await fetch(
                "https://gehsuitesapps.com/agencias/v1/auth/request-password-change",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ email }),
                }
              );

              if (response.ok) {
                Swal.fire({
                  icon: "info",
                  title: "Atencion",
                  text: "Codigo enviado a su correo electronico.",
                  showConfirmButton: false,
                  timer: 3600,
                });
                requestCodeForm.style.display = "none";
                verifyCodeForm.style.display = "block";
              } else {
                const errorData = await response.json();
                Swal.fire({
                  icon: "error",
                  title: "Error al intentar recuperar contraseña",
                  text: errorData.message || "Error al enviar el código. Por favor, verifica tu correo.",
                  showConfirmButton: false,
                  timer: 5000,
                });
              }
            } catch (error) {
              console.error("Error:", error);
              Swal.fire({
                icon: "error",
                title: "Algo salió mal...",
                text: "Hubo un error al procesar tu solicitud.",
                showConfirmButton: false,
                timer: 3600,
              });
            } finally {
              hideSpinner();
            }
          });

          // ------------------------Verificar código OTP---------------------
          verifyBtn.addEventListener("click", async () => {
            const otp = otpInput.value.trim();
            const email = emailInput.value.trim();
            //--- Mostrar el spinner---
            const showSpinner = () => {
              const spinner = document.getElementById("spinner-overlay");
              spinner.style.display = "flex";
            };

            // ---Ocultar el spinner---
            const hideSpinner = () => {
              const spinner = document.getElementById("spinner-overlay");
              spinner.style.display = "none";
            };

            if (!otp) {
              Swal.fire({
                icon: "info",
                title: "Algo salió mal...",
                text: "Porfavor, ingresa el codigo de verificacion",
                showConfirmButton: false,
                timer: 3600,
              });
              return;
            }
                  showSpinner(); // Mostrar spinner
            try {
              const response = await fetch(
                "https://gehsuitesapps.com/agencias/v1/auth/validate-otp",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ email, otp }),
                }
              );

              if (response.ok) {
                const data = await response.json();
                const token = data.token;
                tokenglobal.set(token);

                Swal.fire({
                  icon: "success",
                  title: "Aprobado",
                  text: "Codigo verificado correctamente",
                  showConfirmButton: false,
                  timer: 3600,
                });
                verifyCodeForm.style.display = "none";
                setPasswordForm.style.display = "block";
                return token;
              } else {
                Swal.fire({
                  icon: "error",
                  title: "Oops...",
                  text: "El codigo ingresado es incorrecto.",
                  showConfirmButton: false,
                  timer: 3600,
                });
              }
            } catch (error) {
              console.error("Error:", error);
              alert("Hubo un error al verificar el código.");
            }finally{
              hideSpinner(); //Ocultar spinner
            }
          });

          // Guardar nueva contraseña
          setPasswordBtn.addEventListener("click", async () => {
            const token = tokenglobal.get();
            const password = newPasswordInput.value.trim();
            const confirmPassword = confirmPasswordInput.value.trim();

            if (!password || !confirmPassword) {
              Swal.fire({
                icon: "error",
                title: "Algo salió mal...",
                text: "Porfavor,completa todos los campos",
                showConfirmButton: false,
                timer: 3600,
              });
              return;
            }

            if (password !== confirmPassword) {
              Swal.fire({
                icon: "error",
                title: "Algo salió mal...",
                text: "Las contraseñas no coinciden.",
                showConfirmButton: false,
                timer: 3600,
              });
              return;
            }

            try {
              const response = await fetch(
                "https://gehsuitesapps.com/agencias/v1/auth/new-credentials",
                {
                  method: "PATCH",
                  headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                  },
                  body: JSON.stringify({ password }),
                }
              );

              if (response.ok) {
                Swal.fire({
                  icon: "success",
                  title: "Aprobado",
                  text: "Contraseña actualizada correctamente.",
                  showConfirmButton: false,
                  timer: 3600,
                });
                window.location.href = "/login"; // Redirige al inicio de sesión
              } else {
                console.error("Hubo un error en la solicitud.");
                console.error("Código de estado:", response.status);
                const errorMessage = await response.text();
                console.error("Respuesta:", errorMessage);
                Swal.fire({
                icon: "error",
                title: "Ingrese una contraseña diferente.",
                text: "La contraseña no puede ser igual a la anterior.",
                showConfirmButton: false,
                timer: 3600,
              });
              }
            } catch (error) {
              console.error("Error:", error);
              alert("Hubo un error al actualizar tu contraseña.");
            }
          });
        </script>
      </div>
    </div>

    <style>
      body,
      html {
        margin: 0;
        padding: 0;
        font-family: "Roboto", sans-serif;
      }

      .container {
        display: flex;
        width: 100%;
        height: 100vh;
      }

      .video-section video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .form-container {
        max-width: 400px;
        width: 100%;
        height: 100%;
        padding-left: 100px;
      }

      .form-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
      }
      .form-container {
        max-width: 400px;
        width: 100%;
        height: 100%;
        padding-left: 100px;
      }

      .logo {
        padding-top: 15%;
        text-align: left;
        margin-bottom: 20px;
      }

      .logo img {
        width: 170px;
        padding-bottom: 10px;
      }

      .form-title {
        padding-top: 20px;
        font-size: 24px;
        font-weight: 700;
        color: #1c3d5a;
        margin-bottom: 10px;
        text-align: left;
      }
      h1 {
        padding-top: 20px;
        font-size: 24px;
        font-weight: 700;
        color: #1c3d5a;
        margin-bottom: 10px;
        text-align: left;
      }

      .form-subtitle {
        font-size: 16px;
        color: #1c3d5a;
        margin-bottom: 30px;
        text-align: left;
      }

      .form-group {
        padding-top: 25px;
        margin-bottom: 20px;
        width: 100%;
      }

      .form-group label {
        padding-top: 10px;
        display: block;
        font-size: 14px;
        color: #1c3d5a;
        margin-bottom: 5px;
        padding-top: 10px;
      }

      .form-group input {
        width: 100%;
        padding: 10px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 4px;
      }

      hr {
        width: 100%;
        color: #cfcece;
        opacity: 0.4;
      }

      .form-group .input-wrapper {
        position: relative;
        width: 100%;
      }

      button {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        color: white;
        background-color: #1c3d5a;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        
      }

      button:hover{
        background-color: #0b2236;
      
      }

      /* Spinner */
  .spinner-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    display: none; /* Oculto por defecto */
  }

  .spinner {
    border: 5px solid rgba(0, 0, 0, 0.1);
    border-top: 5px solid #1c3d5a;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
    </style></body>
</html>
