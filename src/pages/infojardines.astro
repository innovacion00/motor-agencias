import BaseLayout from "../layouts/BaseLayout.astro"
import DropdownSearch from "../components/DropdownSearch"
---

<BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">
</html>

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet" />

  

  <body>
    <div class="search-form-wrapper">
      <DropdownSearch client:visible />
    </div>

    <div class="container">
      <!-- Menú de botones General y Habitaciones -->
      <div class="nav-tabs">
        <button id="generalBtn" class="active">General</button>
       <!-- <button id="roomsBtn">Habitaciones</button>--> 
      </div>

      <!-- Sección General -->

      <div id="generalSection" class="section active">
        <div class="gallery">
          <img alt="Hotel lobby with reception desk and seating area" class="main-image" 
            src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/223837937.jpg?k=8afb0a29efd7378589bc86a1648c81c1b756a469f0ac8ee9df0d25c03ffa465a&o=&hp=1"  />
          <div class="side-images">
            <img alt="Hotel dining area with tables and chairs" height="150"
              src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/223834258.jpg?k=bca01464b4deaccb524e53bce2a1c673f30a574cf36249dd908d3548b02ce7ab&o=&hp=1" width="250" />
            <img alt="Close-up of a breakfast dish with eggs and toast" height="150"
              src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/223834280.jpg?k=87939358220ae7eff6e469cb4108feb11f58b28285cfa4df3b5a2001600559c8&o=&hp=1" width="250" />
          </div>
        </div>
        <h2>
          Hotel Jardines Evans
        </h2>
        <br>
        <p>
            Hotel Jardines Evans By GEH Suites, está ubicado en la histórica ciudad Santa Cruz de Mompox, la cual ha sido conmemorada y reconocida como Distrito Especial, Turístico, Histórico y Cultural.
          Este hotel es una casa colonial remodelada, con espacios temáticos, confortables, rodeado de naturaleza, ubicados en el centro de la ciudad, en una zona comercial.
        <br> <br>
        A pocos pasos del hotel, encontraremos diversas iglesias, parques, plazas y el Malecón, donde se puede contemplar el colosal del Río Magdalena, talleres de filigrana y artesanías, entre otros sitios de interés.
        
        <hr>
        <div class="services">
          <h3>
            Servicios destacados
          </h3>
          <div class="service-list">
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconcoffee.png" alt="check icon">
                Estación de agua y café (incluido)
              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconvan.png" alt="check icon">
                Transporte del aereopuerto al hotel (adicional)
              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconwind.png" alt="check icon">
                Aire acondicionado
              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconbuffet.png" alt="check icon">
                Desayuno americano (incluido)
              </span>
            </div>
            <div class="service-item">
                <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconparking.png" alt="check icon">
                  Zona de Estacionamiento
                </span>
              </div>
          </div>
        </div>
        <div class="servicess">

          <br>
          <hr>
          <br>
          <h3>
            Servicios generales
          </h3>
          <div class="service-list">
        
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Recepción 24 horas

              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Wifi gratuito

              </span>

            </div>

            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Servicio diario de limpieza

              </span>

            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Estacionamiento gratuito (Sujeto a disponibilidad)

              </span>
            </div>
            
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Servicio de despertador

              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Aire acondicionado

              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Servicio de guarda equipaje

              </span>
            </div>
            <div class="service-item">
              <span><img src="https://space-img.sfo3.digitaloceanspaces.com/Agencias/Iconcheck.png" alt="check icon">

                Parking sin costo adicional por solicitud

              </span>
            </div>
          </div>
        </div>
        <!-- Botones en la parte inferior -->
        <div class="info-box">
          <div class="contact-info">
            <i class="fas fa-phone-alt">
            </i>
            +57 3336025669
            <i class="fas fa-map-marker-alt" style="margin-left: 20px;">
            </i>
            Cra. 2 #19-37, Santa Cruz de Mompox, Mompós, Bolívar
            <a href="https://www.google.com/maps/place/Hotel+Jardines+Evans/@9.2421512,-74.4278307,17z/data=!4m10!3m9!1s0x8e5eed75bc552595:0x4e369878bda30f05!5m3!1s2024-12-01!4m1!1i2!8m2!3d9.2421459!4d-74.4252558!16s%2Fg%2F11bw51j60g?hl=es&entry=ttu&g_ep=EgoyMDI0MDkyNC4wIKXMDSoASAFQAw%3D%3D"
              target="_blank" rel="noopener noreferrer">Ver mapa</a>
          </div>
          <!--<div class="buttons">
            <button>
              Ver habitaciones
            </button>-->
          </div>
        </div>
      </div>

      <br>
       </div>


    </div>

    <script>
      function checkAuth(){
        const token = localStorage.getItem("authToken");
        if(!token){
          window.location.href = "/";
        }
      }

      checkAuth();
      // Seleccionamos los botones y las secciones
      const generalBtn = document.getElementById('generalBtn');
      const roomsBtn = document.getElementById('roomsBtn');
      const generalSection = document.getElementById('generalSection');
      const roomsSection = document.getElementById('roomsSection');

      // Funciones para mostrar/ocultar secciones
      generalBtn.addEventListener('click', () => {
        generalSection.classList.add('active');
        roomsSection.classList.remove('active');
        generalBtn.classList.add('active');
        roomsBtn.classList.remove('active');
      });

      roomsBtn.addEventListener('click', () => {
        roomsSection.classList.add('active');
        generalSection.classList.remove('active');
        roomsBtn.classList.add('active');
        generalBtn.classList.remove('active');
      });
    </script>
  </body>


  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #fff;
      color: #1C3D5A;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 65%;
      margin: 0 auto;
      padding: 20px 0;

    }

    .tabs {
      display: flex;
      justify-content: flex-start;
      margin-bottom: 20px;
    }


    /* Menú de navegación */
    .nav-tabs {
      display: flex;

      margin-bottom: 20px;
    }

    .nav-tabs button {
      padding: 10px 20px;
      margin-right: 10px;
      background: none;
      border: none;
      cursor: pointer;
      color: #1C3D5A;
      border-bottom: 2px solid transparent;
      transition: border-bottom 0.1s ease;
    }

    .nav-tabs button.active {
      border-bottom: 4px solid #8B4513;
      font-weight: bold;
    }

    .nav-tabs button:hover {
      border-bottom: 2px solid #8B4513;
    }

    /* Secciones ocultables */
    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .gallery {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .main-image {
      width: 60%;
      height: auto;
      padding-bottom: 20px;

    }

    .side-images {
      width: 38%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;

    }

    .side-images img {
      width: 100%;
      height: auto;
      margin-bottom: 10px;
      border-radius: 5px;

    }

    .description {
      margin-top: 20px;


    }

    .description h2 {
      font-size: 24px;
      margin-bottom: 10px;

    }

    .description p {
      font-size: 16px;
      line-height: 1.5;


    }

    .services {
      margin-top: 20px;

    }

    .services h3 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .services .service-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .services .service-item {
      width: 25%;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
    }

    .services .service-item i {
      margin-right: 10px;
    }
    .services .service-item img {
      margin-right: 10px;
      height: 25px;
      width: 25px;
    }

    .footer {
      margin-top: 20px;
      padding: 20px 0;
      border-top: 1px solid #444;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer .contact-info {
      display: flex;
      align-items: center;
    }

    .footer .contact-info i {
      margin-right: 10px;
    }

    .footer .buttons {
      display: flex;
    }

    .footer .buttons button {
      background-color: #fff;
      color: #1C3D5A;
      padding: 10px 20px;
      margin-left: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .info-box {
      background-color: #f0f0f0;
      padding: 20px;
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 5px;
    }

    .info-box .contact-info {
      display: flex;
      align-items: center;
    }

    .info-box .contact-info i {
      margin-right: 10px;
    }

    .info-box .contact-info a {
      color: #1C3D5A;
      text-decoration: none;
      margin-left: 10px;
    }

    .info-box .buttons {
      display: flex;
    }

    .info-box .buttons button {
      background-color: #1C3D5A;
      color: #fff;
      padding: 10px 20px;
      margin-left: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }


    .highlighted-services,
    .general-services {
      margin-bottom: 20px;
    }

    .highlighted-services img {
      width: 50px;
      margin-right: 10px;
    }

    .highlighted-services {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .general-services ul {
      list-style-type: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .general-services ul li {
      width: 45%;
      margin-bottom: 10px;
    }

    /* Botones en la parte inferior */
    .bottom-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
    }

    .bottom-buttons button {
      background-color: #007BFF;
      color: white;
      padding: 10px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .bottom-buttons button:hover {
      background-color: #0056b3;
    }

    .bottom-buttons a {
      text-decoration: none;
      color: white;
    }




    .search-form-wrapper {
      background-color: #1C3D5A;
      padding: 20px;
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
    }

    .dropdownSearchContainer {
      display: flex;
      align-items: center;
      gap: 1rem;
      background-color: #F29C38;
      /* Cambia el color del fondo */
      border-radius: 8px;
    }

    hr {
      height: auto;
      width: 100%;
      opacity: 0.5;

    }

    .room h3 {
      padding: 20px;
    }



    .room p {
      padding-left: 20px;
      padding-bottom: 8px;
      padding-top: 8px
    }

    .room {
      margin-bottom: 30px;
      border: 1px solid #eaeaea;
      border-radius: 10px;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      background-color: #f5f5f5;
    }

    .room-header {
      display: flex;
    }

    .room-gallery {
      width: 60%;
    }

    .room-main-image-container {
      margin-bottom: 10px;
      padding-right: 20px;
      display: flex;
    }

    .room-main-image {
      width: 100%;
      border-radius: 1px;

    }

    .room-small-images-container {
      display: flex;
      justify-content: space-between;
      padding-right: 20px;
    }

    .room-small-image {
      width: 49%;
      border-radius: 1px;
    }

    .room-details {
      width: 55%;
    }

    .room-icons {
      padding-left: 20px;
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 16px;
    }

    .room-icons span {
      display: flex;
      align-items: center;
    }

    .room h4 {
      padding-left: 20px;
    }

    .room-services ul {
      list-style-type: none;
      padding-left: 20px;
      padding-top: 13px;
      display: flex;
      flex-wrap: wrap;
    }

    .room-services ul li {
      padding-left: 20px;
      padding-top: 20px;
      width: 45%;
      margin-bottom: 5px;
    }

    .availability-button {
      margin-top: 10px;
      padding: 20px 20px;
      background-color: #033f97;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    @media (max-width: 480px) {
      .container {
        padding: 30px 10px 20px 10px;
      }
    }

    
  </style>