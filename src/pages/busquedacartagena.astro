---
import BaseLayout from "../layouts/BaseLayout.astro";
import Componentesearch from "../components/Componentesearch";
---

<html lang="es">
  <BaseLayout title="Resultados Cartagena - BookingConnect">
    <head>
      <title>Resultados Cartagena de Indias</title>

      <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
        rel="stylesheet"
      />
      <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap"
        rel="stylesheet"
      />
    </head>

    <body>
      <Componentesearch client:load />
    </body>
    <script>
      import Cookies from "js-cookie";
      function checkAuth() {
        const token = Cookies.get("token");
        if (!token) {
          window.location.href = "/login";
        }
      }
      checkAuth(); // Llamamos a esta función al cargar la página
    </script>
  </BaseLayout>
  <style>
    body {
      font-family: "Roboto", sans-serif;
      background-color: #f5f5f5;
      margin: 0;
    }
  </style>

</html>
