---


<BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet" />

  <html>

  <head>
    <div class="search-form-wrapper">
      
    </div>
  </head>

  <body>
  
    <DisponibilidadH client:load id={id}/>
  
  </body>
    
    <script>
      function checkAuth() {
        const token = localStorage.getItem("authToken");
        if (!token) {
          window.location.href = "/login"; // Redirige al login si no hay token
        }
      }

      checkAuth(); // Llamamos a esta función al cargar la página

      document.addEventListener('DOMContentLoaded', () => {
        const selectButtons = document.querySelectorAll('.select-room');
        const selectedRoomsList = document.getElementById('selected-rooms');

        selectButtons.forEach(button => {
          button.addEventListener('click', () => {
            // Obtener información de la habitación
            const roomName = button.getAttribute('data-room');
            const roomPrice = button.getAttribute('data-price');
            const roomimg = button.getAttribute('data-img')

            // Crear un nuevo elemento en la lista
            const roomItem = document.createElement('li');
            roomItem.textContent = `${roomName} - ${roomPrice} `;

            // Evitar duplicados
            if (![...selectedRoomsList.children].some(item => item.textContent === roomItem.textContent)) {
              selectedRoomsList.appendChild(roomItem);
            } else {
              alert("Esta habitación ya fue seleccionada.");
            }
          });
        });
      });
    </script>
  </html>