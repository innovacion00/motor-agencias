---
import { getdisponibility, disponibilidad } from "../../stores/disponibilidad";
// await getdisponibility();
import DisponibilidadH from "../../components/DisponibilidadH.jsx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CurrencySelector from "../../components/Cambiardivisas";
import RouteProtection from "../../components/RouteProtection.astro";
export const prerender = true;

// const localS =  localStorage.getItem("dato")
export async function getStaticPaths() {
  return [
    { params: { id: 9 } }, //Marina
    { params: { id: 1 } }, //Azuan
    { params: { id: 6 } }, //Avexi
    { params: { id: 7 } }, //Bocagrande
    { params: { id: 4 } }, //Aixo
    { params: { id: 5 } }, //Abi
    { params: { id: 3 } }, //Madisson
    { params: { id: 10 } }, //Windsor
    { params: { id: 8 } }, //Rodadero
    { params: { id: 2 } }, //1525
    { params: { id: 48 } }, //Axis
    { params: { id: 44 } }, //Sansiraka
    { params: { id: 41 } }, //Zulita
    { params: { id: 56 } }, //Boquilla
    
  ];
  // return disponibilidad.get().map((idhotel) => ({
  //   params: { id: idhotel.hotel.id }
  // }))
}
const { id } = Astro.params;
const habitaciones = disponibilidad.get().find((vaina) => vaina.hotel.id == id);
---

<BaseLayout title="Habitaciones Diponibles - BookingConnect">
  <RouteProtection />
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <html lang="es">
    <head>
      <div class="search-form-wrapper"></div>
    </head>

    <body>
      <DisponibilidadH client:load id={id} />
    </body>

    <script>

      document.addEventListener("DOMContentLoaded", () => {
        const selectButtons = document.querySelectorAll(".select-room");
        const selectedRoomsList = document.getElementById("selected-rooms");

        selectButtons.forEach((button) => {
          button.addEventListener("click", () => {
            // Obtener información de la habitación
            const roomName = button.getAttribute("data-room");
            const roomPrice = button.getAttribute("data-price");
            const roomimg = button.getAttribute("data-img");

            // Crear un nuevo elemento en la lista
            const roomItem = document.createElement("li");
            roomItem.textContent = `${roomName} - ${roomPrice} `;

            // Evitar duplicados
            if (
              ![...selectedRoomsList.children].some(
                (item) => item.textContent === roomItem.textContent
              )
            ) {
              selectedRoomsList.appendChild(roomItem);
            } else {
              alert("Esta habitación ya fue seleccionada.");
            }
          });
        });
      });
    </script>
  </html></BaseLayout
>
