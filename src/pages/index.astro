---
import BaseLayout from "../layouts/BaseLayout.astro";
import SwiperSlider from "../components/SwiperSlider.jsx";
import DropdownSearch from "../components/DropdownSearch.jsx";
import "bootstrap/dist/css/bootstrap.min.css";
import { destinos } from "../data/hoteles-destinos.json";

const ICONOS: Record<string, string> = {
  playa: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconplaya.png",
  coffee: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconcoffee.png",
  buffet: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconbuffet.png",
  pool: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconpool.png",
  parking: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconparking.png",
  gym: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/icongym.png",
  van: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconvan.png",
  wind: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/iconwind.png",
  pet: "https://space-img.sfo3.digitaloceanspaces.com/Agencias/pet-friendly-black-glyph-ui-icon-vector-45097836-Photoroom.png",
};
---

<html lang="es">
  <BaseLayout title="Bienvenido a Booking Connect">
    <head>
      <title>Bienvenido a Booking Connect</title>
      <link rel="stylesheet" href="/styles/Swipper.css" />
      <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
        rel="stylesheet"
      />
      <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
      <link rel="icon" href="/favicon.png" type="image/x-icon" />
      <!-- ASKSUITE CODE START --> <script id="script-infochat" src='https://cdn.asksuite.com/infochat.js?dataConfig=https://control.asksuite.com/api/companies/hotel-rodadero-inn-by-geh-suites'></script> <!-- ASKSUITE CODE END -->
    </head>

    <body>
      <br />
      <div class="swiper-slider-wrapper">
        <SwiperSlider client:load />
      </div>

      <div class="search-form-wrapper">
        <DropdownSearch client:load />
      </div>

      <div class="container">
        <div class="header">
          
          <h1>Conoce los mejores destinos con GEH Suites</h1>
          <p>
            Contamos con infraestructuras modernas y confortables, ideales para
            todo tipo de viajero.
          </p>
        </div>
        <div class="nav" role="tablist" aria-label="Destinos">
          {destinos.map((destino, index) => (
            <button class={index === 0 ? "active" : undefined}>
              {destino.titulo}
            </button>
          ))}
        </div>

        {destinos.map((destino, index) => (
          <div id={destino.id} class={index === 0 ? "content active" : "content"}>
            <h2>{destino.titulo}</h2>
            <p>{destino.descripcion}</p>
            <div class="hotels">
              {destino.hoteles.map((hotel) => (
                <div class="hotel">
                  <img
                    alt={hotel.alt}
                    height="200"
                    src={hotel.img}
                    width={hotel.width}
                  />
                  <div class="info">
                    <div class="hotel-header">
                      <img
                        src={hotel.logo}
                        alt="logo_hotel"
                        class="hotel-logo"
                        style={hotel.logoStyle}
                      />
                      <h3 style={hotel.nombreStyle}>{hotel.nombre}</h3>
                      {hotel.especial && (
                        <img
                          src={hotel.especial.src}
                          alt="logo_hotel"
                          class={hotel.especial.clase}
                        />
                      )}
                    </div>
                    <div class="icons">
                      {hotel.iconos.map((icono) => (
                        <img
                          src={ICONOS[icono]}
                          alt={`icon_${icono}`}
                          width="24"
                          height="24"
                        />
                      ))}
                    </div>
                    <div class="button">
                      <a href={hotel.url}>
                        <button>Ver hotel</button>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Script para manejar la visibilidad de las secciones -->
      <script>
        const hideAllCitySections = () => {
          document.querySelectorAll(".content").forEach((section) => {
            (section as HTMLElement).style.display = "none";
            section.classList.remove("active");
          });
        };

        const showCitySection = (sectionId: any) => {
          const section = document.getElementById(sectionId);
          if (section) {
            (section as HTMLElement).style.display = "block";
            section.classList.add("active");
          }
        };

        const resetCityTabs = () => {
          const tabsNav = document.querySelector(".container .nav");
          if (!tabsNav) return;

          const buttons = tabsNav.querySelectorAll("button");
          if (!buttons.length) return;

          hideAllCitySections();
          showCitySection("cartagenadeindias");

          buttons.forEach((btn, index) => {
            btn.classList.toggle("active", index === 0);
          });
        };

        // View Transitions no vuelve a disparar DOMContentLoaded al regresar al inicio
        document.addEventListener("astro:page-load", resetCityTabs);

        document.addEventListener("click", (event) => {
          const button = (event.target as Element | null)?.closest(
            ".container .nav button"
          );
          if (!button) return;

          const tabsNav = document.querySelector(".container .nav");
          if (!tabsNav || !tabsNav.contains(button)) return;

          const buttons = tabsNav.querySelectorAll("button");

          hideAllCitySections();

          buttons.forEach((btn) => btn.classList.remove("active"));
          button.classList.add("active");

          const sectionId = button.textContent
            ?.trim()
            .toLowerCase()
            .replace(/\s+/g, "");
          if (sectionId) {
            showCitySection(sectionId);
          }
        });
      </script>
    </body>

    <style>
      :root {
        --home-navy: #1c3d5a;
        --home-navy-dark: #152f47;
        --home-orange: #f29c38;
        --home-orange-soft: #f5d7b4;
        --home-surface: #ffffff;
        --home-muted: #5a6b7d;
        --home-radius: 16px;
        --home-shadow: 0 8px 32px rgba(28, 61, 90, 0.1);
        --home-shadow-hover: 0 16px 40px rgba(28, 61, 90, 0.16);
      }

      body {
        font-family: "Roboto", sans-serif;
        background: linear-gradient(165deg, #f0f4f8 0%, #e8eef4 45%, #f5f7fa 100%);
        margin: 0;
        color: var(--home-navy);
        line-height: 1.5;
      }

      .swiper-slider-wrapper {
        width: 100%;
      }

      .search-form-wrapper {
        background: linear-gradient(135deg, var(--home-orange) 0%, #e08a28 100%);
        padding: 20px;
        border-radius: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        box-sizing: border-box;
        width: 100%;
        box-shadow: 0 4px 20px rgba(242, 156, 56, 0.25);
      }

      .container {
        max-width: 1200px;
        background: var(--home-surface);
        margin: 24px auto;
        padding: 28px 24px 36px;
        border-radius: 20px;
        box-sizing: border-box;
        box-shadow: var(--home-shadow);
        border: 1px solid rgba(28, 61, 90, 0.06);
      }

      .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 8px 12px 28px;
        max-width: 720px;
        margin: 0 auto 8px;
        width: 100%;
        box-sizing: border-box;
      }

      .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        margin-bottom: 14px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--home-navy);
        background: linear-gradient(135deg, var(--home-orange-soft) 0%, #fff 100%);
        border: 1px solid rgba(242, 156, 56, 0.35);
        border-radius: 999px;
      }

      .header-badge i {
        color: var(--home-orange);
        font-size: 14px;
      }

      .header h1 {
        margin: 0 0 12px;
        width: 100%;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
        color: var(--home-navy);
        line-height: 1.25;
      }

      .header p {
        margin: 0;
        width: 100%;
        font-size: 1rem;
        color: var(--home-muted);
        line-height: 1.6;
      }

      .nav {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 28px;
        flex-wrap: wrap;
        padding: 6px;
        background: #f0f3f7;
        border-radius: 14px;
        max-width: 640px;
        margin-left: auto;
        margin-right: auto;
      }

      .nav button {
        flex: 1 1 auto;
        min-width: 140px;
        margin: 0;
        padding: 12px 18px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        color: var(--home-navy);
        background: transparent;
        border: none;
        border-radius: 10px;
        transition:
          background-color 0.25s ease,
          color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .nav button:hover:not(.active) {
        background: rgba(255, 255, 255, 0.7);
        color: var(--home-navy-dark);
      }

      .nav button.active {
        color: #fff;
        background: linear-gradient(
          135deg,
          var(--home-navy) 0%,
          var(--home-navy-dark) 100%
        );
        box-shadow: 0 4px 14px rgba(28, 61, 90, 0.35);
      }

      .content {
        display: none;
      }

      .content.active {
        display: block;
        background: linear-gradient(180deg, #fafbfc 0%, #f4f6f9 100%);
        padding: 32px 20px 40px;
        border-radius: var(--home-radius);
        border: 1px solid rgba(28, 61, 90, 0.06);
      }

      .content h2 {
        text-align: center;
        background: linear-gradient(135deg, var(--home-navy) 0%, #2a5278 100%);
        color: #ffffff;
        padding: 12px 24px;
        margin: 0 auto 20px;
        border-radius: 12px;
        width: fit-content;
        max-width: min(90%, 420px);
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 16px rgba(28, 61, 90, 0.2);
      }

      .content p {
        text-align: center;
        margin: 0 auto 28px;
        max-width: 640px;
        font-size: 1rem;
        color: var(--home-muted);
        padding: 18px 22px;
        background: var(--home-surface);
        border-radius: 12px;
        border: 1px solid rgba(28, 61, 90, 0.08);
        box-shadow: 0 2px 12px rgba(28, 61, 90, 0.04);
      }

      .hotels {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
        justify-content: center;
        padding: 0 4px;
      }

      .hotel {
        background: var(--home-surface);
        border: 1px solid rgba(28, 61, 90, 0.08);
        width: 100%;
        max-width: 340px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        box-shadow: var(--home-shadow);
        border-radius: var(--home-radius);
        overflow: hidden;
        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease;
      }

      .hotel:hover {
        transform: translateY(-6px);
        box-shadow: var(--home-shadow-hover);
      }

      .hotel > img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
      }

      .hotel .info {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 16px 18px 20px;
      }

      .hotel .hotel-header {
        display: flex;
        align-items: center;
        min-height: 80px;
        margin-bottom: 12px;
        gap: 12px;
      }

      .hotel .hotel-logo {
        width: 48px;
        height: auto;
        flex-shrink: 0;
        margin-right: 0;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.06));
      }

      .hotel .especial {
        width: 80px;
        height: auto;
      }

      .hotel .especiall {
        width: 80px;
        margin-left: 0;
        height: auto;
      }

      .hotel .info h3 {
        font-weight: 700;
        margin: 0;
        font-size: 1.05rem;
        color: var(--home-navy);
        line-height: 1.3;
      }

      .hotel .icons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
        padding: 10px 12px;
        background: #f8fafc;
        border-radius: 10px;
      }

      .hotel .info .icons {
        padding: 10px 12px;
        margin: 0 0 16px;
      }

      .hotel .info .button {
        text-align: center;
        margin-top: auto;
        padding-top: 4px;
      }

      .hotel .info .button a {
        display: block;
        width: 100%;
        text-decoration: none;
      }

      .hotel .info .button button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        max-width: 100%;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(
          135deg,
          var(--home-navy) 0%,
          var(--home-navy-dark) 100%
        );
        border: none;
        border-radius: 10px;
        cursor: pointer;
        box-sizing: border-box;
        transition:
          background 0.25s ease,
          transform 0.2s ease,
          box-shadow 0.25s ease;
        box-shadow: 0 4px 12px rgba(28, 61, 90, 0.25);
      }

      .hotel .info .button button::before {
        content: "\f061";
        font-family: "Font Awesome 5 Free";
        font-weight: 900;
        font-size: 12px;
      }

      .hotel .info .button button:hover {
        background: linear-gradient(135deg, var(--home-orange) 0%, #e08a28 100%);
        box-shadow: 0 6px 18px rgba(242, 156, 56, 0.4);
        transform: translateY(-1px);
      }

      .discount {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: var(--home-orange-soft);
        padding: 5px 10px;
        font-size: 14px;
        font-weight: bold;
        border-radius: 8px;
      }

      .icons img {
        width: 26px;
        height: 26px;
        object-fit: contain;
        margin-right: 0;
      }

      @media (max-width: 768px) {
        .search-form-wrapper {
          padding: 14px;
          gap: 10px;
        }

        .container {
          margin: 0;
          padding: 16px 14px 24px;
          border-radius: 0;
          box-shadow: none;
          border: none;
        }

        .nav {
          max-width: 100%;
          flex-direction: column;
        }

        .nav button {
          width: 100%;
          min-width: 0;
        }

        .content.active {
          padding: 20px 12px 28px;
          border-radius: 12px;
        }

        .content p {
          margin: 0 auto 20px;
        }

        .hotels {
          grid-template-columns: 1fr;
          gap: 20px;
        }

        .hotel {
          max-width: 100%;
        }
      }

      @media (max-width: 480px) {
        .header {
          padding: 4px 0 20px;
        }

        .header-badge {
          font-size: 12px;
          padding: 5px 12px;
        }

        .content h2 {
          width: 100%;
          max-width: 100%;
          font-size: 1rem;
          padding: 10px 16px;
        }

        .hotel > img {
          height: 180px;
        }

        .search-form-wrapper {
          padding: 10px;
        }
      }
    </style>

    <!-- Hero Swiper: escritorio sin estirar; móvil banda baja con recorte proporcional -->
    <style is:global>
      .swiper-slider-wrapper .swiper-home-hero .swiper-slide {
        overflow: hidden;
      }

      .swiper-slider-wrapper .swiper-home-hero .swiper-slide img {
        width: 100%;
        height: auto;
        max-height: min(70vh, 800px);
        object-fit: contain;
        object-position: center center;
      }

      @media (max-width: 768px) {
        .swiper-slider-wrapper {
          width: 100%;
          height: clamp(120px, 22vh, 200px);
          overflow: hidden;
          border-radius: 0 0 12px 12px;
          box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
          background: #0a1628;
        }

        .swiper-slider-wrapper .swiper-home-hero {
          width: 100%;
          height: 100%;
          margin-left: auto;
          margin-right: auto;
        }

        .swiper-slider-wrapper .swiper-home-hero .swiper-wrapper {
          height: 100%;
        }

        .swiper-slider-wrapper .swiper-home-hero .swiper-slide {
          height: 100%;
          min-height: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          box-sizing: border-box;
        }

        .swiper-slider-wrapper .swiper-home-hero .swiper-slide > a {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 100%;
          height: 100%;
          min-height: 0;
        }

        .swiper-slider-wrapper .swiper-home-hero .swiper-slide img {
          width: 100%;
          height: 100%;
          max-height: none;
          max-width: none;
          object-fit: cover;
          object-position: center center;
          flex-shrink: 0;
        }

        .swiper-slider-wrapper .swiper-button-next,
        .swiper-slider-wrapper .swiper-button-prev {
          color: #ff8533;
        }

        .swiper-slider-wrapper .swiper-button-next::after,
        .swiper-slider-wrapper .swiper-button-prev::after {
          font-size: 22px;
        }

        .swiper-slider-wrapper .swiper-pagination-bullet {
          width: 8px;
          height: 8px;
        }
      }
    </style>
  </BaseLayout>
</html>