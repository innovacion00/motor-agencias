---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';  // Si tienes este componente para listar hoteles
import Card from '../components/RoomCard.astro';

---

<BaseLayout title="Bienvenido a GEH Suites - Reserva de Hoteles">
 
  
</BaseLayout>
<html>
  <body>
    <h2>Hoteles Destacados</h2>
    
    <section class="hotelscard">
      
      <div class="hotel-list">
        <HotelCard 
        imageUrl="/images/hotelaixo.jpg"
        title="Hotel Aixo"
        buttonText="Reservar"
        buttonLink=''
        />
        <HotelCard 
        imageUrl="/images/hotelavexi.jpg"
        title="Hotel Avexi"
        buttonText="Reservar"
        buttonLink=''
        />
        <HotelCard 
        imageUrl="/images/hotelbocagrande.jpg"
        title="Hotel Bocagrande"
        buttonText="Reservar"
        buttonLink=''
        />
      
      </div>
    </section>

    <h2>Habitaciones Destacadas</h2>
    <section class="cards-section">
      
      <Card 
          imageUrl="/images/roomEstandar.jpg"
          title="Habitación Estandar"
          description="Disfruta de una estancia cómoda y lujosa con todas las comodidades."
          buttonText="Reservar"
          buttonLink="/booking"
      />

      <Card 
          imageUrl="/images/roomcuadruple.jpg"
          title="Habitacion Cuadruple"
          description="Disfruta de una estancia cómoda y lujosa con capacidad para cuatro personas."
          buttonText="Explorar"
          buttonLink="/services"
      />

      <Card 
          imageUrl="/images/RoomDoble.jpg"
          title="Habitacion Doble "
          description="Disfruta de una estancia cómoda y lujosa con todas las comodidades.."
          buttonText="Ver Oferta"
          buttonLink="/promotions"
      />
  </section>
</body>
</html>


<style>
    .cards-section {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        padding: 20px;
    }

    .hotelscard{
      display: flex;
        flex-wrap: wrap;
        justify-content: center;
        padding: 20px;


    }

</style>