---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';  // Si tienes este componente para listar hoteles
---

<BaseLayout title="Bienvenido a GEH Suites - Reserva de Hoteles">
  <section class="hero">
    <h1>Bienvenido a GEH Suites</h1>
    <p>Disfruta de una experiencia única en nuestros hoteles de lujo.</p>
  </section>

  <section class="hotels-featured">
    <h2>Hoteles Destacados</h2>
    <div class="hotel-list">
      <HotelCard />
      <HotelCard />
      <HotelCard />
    </div>
  </section>
</BaseLayout>
<div class="wis2-panel wis2-panel--horizontal">								<div class="wis2-el wis2-title ">		<span>Reservar</span> online</div>										<div class="wis2-el wis2-chain-hld">		<select name="chainSites" data-placeholder="Elige el hotel" class="js-wis2-chain" id="wis2-chain" style="display: none;">				<option value=""></option>							<option value="gehsuiteshotelsbogota">Bogotá</option>							<option value="gehsuiteshotelscartagenadeindias">Cartagena de Indias</option>							<option value="gehsuiteshotelssantamarta">Santa Marta</option>					</select><div class="chosen-container chosen-container-single chosen-container-single-nosearch" style="width: 173px;" title="" id="wis2_chain_chosen"><a class="chosen-single chosen-default"><span>Elija un destino</span><div><b></b></div></a><div class="chosen-drop"><div class="chosen-search"><input type="text" autocomplete="off" readonly=""></div><ul class="chosen-results"></ul></div></div>	</div>										<div class="js-wis2-mixpicker" id="wis2-mixpicker" data-checkin="2024-08-23" data-checkout="2024-08-24"></div><div class="wis2-el wis2-input-group">	<div class="wis2-label">Check-in</div>	<div class="wis2-input wis2-input--icon mixpicker-trigger js-wis2-checkin" id="wis2-checkin">23 ago. 2024</div></div><div class="wis2-el wis2-input-group">	<div class="wis2-label">Check-out</div>	<div class="wis2-input wis2-input--icon mixpicker-trigger js-wis2-checkout" id="wis2-checkout">24 ago. 2024</div></div>										<div class="wis2-el wis2-button-hld">	<a href="#" class="wis2-button wis2-button--primary js-wis2-open-booking" id="wis2-open-booking">Comprobar la disponibilidad</a></div>			</div>