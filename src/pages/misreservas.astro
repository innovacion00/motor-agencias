    <html lang = "es">

</head>
<body>
    <Tabla client:load/>
    <script>
        function checkAuth() {
    const token = localStorage.getItem("authToken");
    if (!token) {
      window.location.href = "/login"; // Redirige al login si no hay token
    }
  }

  checkAuth(); // Llamamos a esta función al cargar la página
    </script>
</body>
</html>

<style>
    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f5f5f5;
        margin: 0;
        padding: 0;
    }
    
</style>