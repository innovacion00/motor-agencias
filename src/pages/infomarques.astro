      }

      .services h3 {
        font-size: 20px;
        margin-bottom: 10px;
      }

      .services .service-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
      }

      .services .service-item {
        width: 25%;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
      }

      .services .service-item i {
        margin-right: 10px;
      }
      .services .service-item img {
        margin-right: 10px;
        height: 25px;
        width: 25px;
      }

      .footer {
