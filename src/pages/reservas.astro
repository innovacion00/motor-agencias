import { fetchWithAuth } from '../utils/fetchWithAuth';

async function fetchProtectedData() {
  const data = await fetchWithAuth("URL_PROTEGIDA");
  console.log(data);
}
import BaseLayout from '../layouts/BaseLayout.astro';
import ReservationForm from '../components/ReservationForm.jsx';
---
<BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">
  
  <html>
  <head>
    
    <link rel="stylesheet" href="/public/styles/ReservationForm.css" />
  </head>
  
  <body>
    <ReservationForm client:load />


    <script>
      function checkAuth() {
    const token = localStorage.getItem("authToken");
    if (!token) {
      window.location.href = "http://localhost:4321"; // Redirige al login si no hay token
    }
  }

  checkAuth(); // Llamamos a esta función al cargar la página
    </script>
  </body>
</html>

  
  