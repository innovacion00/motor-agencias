---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gestionar from "../../components/GestionarReservas/Gestionar";
import CurrencySelector from "../../components/Cambiardivisas";
import { getReservaByIdServer } from "../../stores/disponibilidad";

export const prerender = false;

const cookieToken = Astro.cookies.get("accessToken");
const cookieUser = Astro.cookies.get("datosUsuario");


// Verificar autenticación
if (!cookieToken || !cookieUser) {
  return Astro.redirect("/login");
}

const userData = JSON.parse(cookieUser.value);
const { id } = Astro.params;

// Buscar la reserva específica por ID (busca en todas las páginas si es necesario)
const reserva = await getReservaByIdServer(cookieToken.value, userData.role, id);

// Si no se encuentra la reserva específica, redirigir
if (!reserva) {
  return Astro.redirect("/misreservas");
}
---

<BaseLayout title="Consultar y gestionar - BookingConnect ">
  <Gestionar reservas={reserva} client:load />
</BaseLayout>


<script>
  import Cookies from "js-cookie";

  // El middleware SSR (src/middleware.ts) ya valida y refresca el token al
  // cargar la página, por lo que aquí solo verificamos que exista sesión.
  // (Antes se llamaba a refreshToken() en cada carga, lo que provocaba una
  // doble rotación del refresh token con el middleware y cierres de sesión
  // inesperados.)
  function checkAuth() {
    const token = Cookies.get("accessToken");
    if (!token) {
      window.location.href = "/login";
      return;
    }
  }

  checkAuth();
</script>
