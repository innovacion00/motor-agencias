---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gestionar from "../../components/GestionarReservas/Gestionar";
import CurrencySelector from "../../components/Cambiardivisas";
import { getReservas, reservasNano } from "../../stores/disponibilidad";

export const prerender = false;

const cook = Astro.cookies.get("token");
const rol = Astro.cookies.get("datosUsuario");

if (!cook || !rol) {
  return Astro.redirect("/login");
}

const roles = JSON.parse(rol.value).role;
const reservas = await getReservas(JSON.parse(cook.value), roles);

if (!reservas) {
  return Astro.redirect("/login");
}

console.log(roles);
const { id } = Astro.params;
const reserva = reservas.find((dato) => dato.reservaChatbotId == id);
---

<BaseLayout title="Consultar y gestionar - BookingConnect ">
  <Gestionar reservas={reserva} client:load />
</BaseLayout>
<script>
  import Cookies from "js-cookie";
  function checkAuth() {
    const token = Cookies.get("token");

    if (!token) {
      window.location.href = "/login";
    }
  }
  checkAuth();
</script>
