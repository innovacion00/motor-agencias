---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gestionar from "../../components/GestionarReservas/Gestionar";
import { getReservas, reservasNano } from "../../stores/disponibilidad";

export const prerender = false;

const cook = Astro.cookies.get("token");
const rol = Astro.cookies.get("datosUsuario");
const roles = JSON.parse(rol.value).role;
const reservas = await getReservas(JSON.parse(cook.value), roles);

console.log(roles);
const { id } = Astro.params;

const reserva = reservas.find((dato) => dato.reservaChatbotId == id);
// console.log(reservasNano.get())
---
<BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    
      <Gestionar reservas={reserva} client:load />
    
  </body>
</html>
