---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gestionar from "../../components/GestionarReservas/Gestionar";
import { getReservas, reservasNano } from "../../stores/disponibilidad";

export async function getStaticPaths() {
  await getReservas(
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJfaWQiOiI2NzZhZmVhNDE4MmY2ODI4YmVmNWZmN2IiLCJpYXQiOjE3MzU2NDk5MDUsImV4cCI6MTc2NzE4NTkwNX0.R8-FVvNXstzZIWFoaDtIenUoG7-QiRYTKagMWSHM9Zw"
  );
  // console.log(reservasNano.get());
  return reservasNano
    .get()
    .map((dato) => ({ params: { id: dato.reservaChatbotId } }));
}
const { id } = Astro.params;

const reserva = reservasNano.get().find((dato) => dato.reservaChatbotId == id);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestionar</title>
  </head>
  <body>
    <BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">
      <Gestionar reservas={reserva} client:load />
      <!-- <p>Hola {token}</p> -->
    </BaseLayout>
  </body>
</html>
