---
import BaseLayout from "../layouts/BaseLayout.astro";
import BusquedaeventosB from "../components/BusquedaeventosB";
---

<html>
  <BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <head>
      <title>Resultados Bogotá</title>
      <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
        rel="stylesheet"
      />
    </head>

    <body>
      <BusquedaeventosB client:load />

      <script>
        import Cookies from "js-cookie";
        function checkAuth() {
          const token = Cookies.get("token");

          if (!token) {
            window.location.href = "/login";
          }
        }

        checkAuth(); // Llamamos a esta función al cargar la página
      </script>
    </body>
  </BaseLayout>
</html>
