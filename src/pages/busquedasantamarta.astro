---
import BaseLayout from "../layouts/BaseLayout.astro";
import Componentesearch from "../components/Componentesearch";
import CurrencySelector from "../components/Cambiardivisas";
---

<title>Resultados Santa Marta</title>

<BaseLayout title="Resultados Santa Marta - BookingConnect">
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap"
    rel="stylesheet"
  />
  <html lang="es">
    <head>
      <title>Resultados Santa Marta</title>
      <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
        rel="stylesheet"
      />
    </head>

    <body>
      <Componentesearch client:load />
    </body>
    <script>
      import Cookies from "js-cookie";
      function checkAuth() {
        const token = Cookies.get("token");

        if (!token) {
          window.location.href = "/login";
        }
      }
      checkAuth(); // Llamamos a esta función al cargar la página
    </script>
  </html>
</BaseLayout>
