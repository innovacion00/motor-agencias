  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #fff;
      color: #1C3D5A;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 80%;
      margin: 0 auto;
      padding: 20px 0;

    }

    .tabs {
      display: flex;
      justify-content: flex-start;
      margin-bottom: 20px;
    }


    /* Menú de navegación */
    .nav-tabs {
      display: flex;

      margin-bottom: 20px;
    }

    .nav-tabs button {
      padding: 10px 20px;
      margin-right: 10px;
      background: none;
      border: none;
      cursor: pointer;
      color: #1C3D5A;
      border-bottom: 2px solid transparent;
      transition: border-bottom 0.1s ease;
    }

    .nav-tabs button.active {
      border-bottom: 4px solid #8B4513;
      font-weight: bold;
    }

    .nav-tabs button:hover {
      border-bottom: 2px solid #8B4513;
    }

    /* Secciones ocultables */
    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .gallery {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .main-image {
      width: 60%;
      height: auto;
      padding-bottom: 20px;

    }

    .side-images {
      width: 38%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;

    }

    .side-images img {
      width: 100%;
      height: auto;
      margin-bottom: 10px;
      border-radius: 5px;

    }

    .description {
      margin-top: 20px;


    }

    .description h2 {
      font-size: 24px;
      margin-bottom: 10px;

    }

    .description p {
      font-size: 16px;
      line-height: 1.5;


    }

    .services {
      margin-top: 20px;

    }

    .services h3 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .services .service-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .services .service-item {
      width: 25%;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
    }

    .services .service-item i {
      margin-right: 10px;
    }
    .services .service-item img {
      margin-right: 10px;
      height: 25px;
      width: 25px;
    }
    .footer {
      margin-top: 20px;
      padding: 20px 0;
      border-top: 1px solid #444;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer .contact-info {
      display: flex;
      align-items: center;
    }

    .footer .contact-info i {
      margin-right: 10px;
    }

    .footer .buttons {
      display: flex;
    }

    .footer .buttons button {
      background-color: #fff;
      color: #1C3D5A;
      padding: 10px 20px;
      margin-left: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .info-box {
      background-color: #f0f0f0;
      padding: 20px;
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 5px;
    }

    .info-box .contact-info {
      display: flex;
      align-items: center;
    }

    .info-box .contact-info i {
      margin-right: 10px;
    }

    .info-box .contact-info a {
      color: #1C3D5A;
      text-decoration: none;
      margin-left: 10px;
    }

    .info-box .buttons {
      display: flex;
    }

    .info-box .buttons button {
      background-color: #1C3D5A;
      color: #fff;
      padding: 10px 20px;
      margin-left: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }


    .highlighted-services,
    .general-services {
      margin-bottom: 20px;
    }

    .highlighted-services img {
      width: 50px;
      margin-right: 10px;
    }

    .highlighted-services {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .general-services ul {
      list-style-type: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .general-services ul li {
      width: 45%;
      margin-bottom: 10px;
    }

    /* Botones en la parte inferior */
    .bottom-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
    }

    .bottom-buttons button {
      background-color: #007BFF;
      color: white;
      padding: 10px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .bottom-buttons button:hover {
      background-color: #0056b3;
    }

    .bottom-buttons a {
      text-decoration: none;
      color: white;
    }




