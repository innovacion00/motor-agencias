---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DetalleEvento from "../../components/DetalleEvento";

const { id } = Astro.params;
---

<BaseLayout title="Detalle del Evento - BookingConnect">
  <div class="container">
    <DetalleEvento client:load id={id} />
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }
</style>

<script>
  import { validarToken } from "../../stores/authtoken";
  validarToken();
</script>
