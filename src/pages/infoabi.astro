      <script>
        // Seleccionamos los botones y las secciones
        const generalBtn = document.getElementById("generalBtn");
        const roomsBtn = document.getElementById("roomsBtn");
        const generalSection = document.getElementById("generalSection");
        const roomsSection = document.getElementById("roomsSection");

        // Funciones para mostrar/ocultar secciones
        generalBtn.addEventListener("click", () => {
          generalSection.classList.add("active");
          roomsSection.classList.remove("active");
          generalBtn.classList.add("active");
          roomsBtn.classList.remove("active");
        });

        roomsBtn.addEventListener("click", () => {
          roomsSection.classList.add("active");
          generalSection.classList.remove("active");
          roomsBtn.classList.add("active");
          generalBtn.classList.remove("active");
        });
      </script>
