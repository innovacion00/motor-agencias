        margin: 0 auto;
        padding: 20px 0;
      }

      .tabs {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 20px;
      }

      /* Menú de navegación */
      .nav-tabs {
        display: flex;

        margin-bottom: 20px;
      }

      .nav-tabs button {
        padding: 10px 20px;
        margin-right: 10px;
        background: none;
        border: none;
        cursor: pointer;
        color: #1c3d5a;
        border-bottom: 2px solid transparent;
        transition: border-bottom 0.1s ease;
      }

      .nav-tabs button.active {
        border-bottom: 4px solid #8b4513;
        font-weight: bold;
      }

      .nav-tabs button:hover {
        border-bottom: 2px solid #8b4513;
      }

      /* Secciones ocultables */
      .section {
        display: none;
      }

      .section.active {
        display: block;
      }

      .gallery {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
      }

      .main-image {
