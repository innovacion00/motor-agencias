        height: auto;
        padding-bottom: 20px;
      }

      .side-images {
        width: 38%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .side-images img {
        width: 100%;
        height: auto;
        margin-bottom: 10px;
        border-radius: 5px;
      }

      .description {
        margin-top: 20px;
      }

      .description h2 {
        font-size: 24px;
        margin-bottom: 10px;
      }

      .description p {
