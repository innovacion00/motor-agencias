---
import BaseLayout from "../layouts/BaseLayout.astro"
import DropdownSearch from "../components/DropdownSearch"
---

<BaseLayout title="Bienvenido a GEH SUITES MOTOR DE AGENCIAS">
</html>

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet" />

  

  <body>
    <div class="search-form-wrapper">
      <DropdownSearch client:visible />
    </div>

    <div class="container">
      <!-- Menú de botones General y Habitaciones -->
      <div class="nav-tabs">
        <button id="generalBtn" class="active">General</button>
       <!-- <button id="roomsBtn">Habitaciones</button>--> 
      </div>

      <!-- Sección General -->

      <div id="generalSection" class="section active">
        <div class="gallery">
          <img alt="Hotel lobby with reception desk and seating area" class="main-image" 
            src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/122412410.jpg?k=9ffb59a107f7c908afb26286543db39f9eddcf793f2fb20cc5f2a85302fbad88&o=&hp=1"  />
          <div class="side-images">
            <img alt="Hotel dining area with tables and chairs" height="150"
              src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/122510067.jpg?k=9bdbc343da225dd82c374748fca52a24c58b8ab67a4ec730f3fe92ff57903803&o=&hp=1" width="250" />
            <img alt="Close-up of a breakfast dish with eggs and toast" height="150"
              src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/343944157.jpg?k=726915a75dd5f280cb8988d5163f552460289dc0da1eb89bc47c55890af7a4ec&o=&hp=1" width="250" />
          </div>
        </div>
        <h2>
          Hotel Sabana del Sinú
        </h2>
        <p>
            Disfruta de Montería y sus encantos con Hotel Sabana del Sinú By GEH Suites, 
            es un hotel moderno con espacios únicos, diseñados para vivir la mejor 
            experiencia de todo tipo de segmento de viaje.
          <br><br>
          Contamos con el mejor confort para tu momento de descanso.
          <br><br>
          Estamos ubicados en el centro de Montería, a una cuadra del Río Sinú, a pocos pasos del parque lineal, 
          la plaza cultural de Montería y el muelle turístico de la ciudad. 
        </p>
        <br>
        <hr>
        <div class="services">
          <h3>
            Servicios destacados
          </h3>
          <div class="service-list">
            <div class="service-item">
              <span><img src="/public/images/Iconcoffee.png" alt="check icon">
                Estación de agua y café (incluido)
              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconvan.png" alt="check icon">
                Transporte del aereopuerto al hotel
              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconbuffet.png" alt="check icon">
                Desayuno buffet (incluido)
              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconwind.png" alt="check icon">
                Aire acondicionado
              </span>
            </div>
          </div>
        </div>
        <div class="servicess">

          <br>
          <hr>
          <br>
          <h3>
            Servicios generales
          </h3>
          <div class="service-list">
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">
                Lavanderia/Tintoreria
              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Recepción 24 horas

              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Wifi gratuito

              </span>

            </div>

            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Servicio diario de limpieza

              </span>

            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Estacionamiento gratuito

              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Wifi en todas las areas del hotel

              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Servicio de despertador

              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Aire acondicionado

              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Servicio de guarda equipaje

              </span>
            </div>
            <div class="service-item">
              <span><img src="/public/images/Iconcheck.png" alt="check icon">

                Restaurante

              </span>
            </div>
          </div>
        </div>
        <!-- Botones en la parte inferior -->
        <div class="info-box">
          <div class="contact-info">
            <i class="fas fa-phone-alt">
            </i>
            +57 333 602 50 21
            <i class="fas fa-map-marker-alt" style="margin-left: 20px;">
            </i>
            Cl. 36 #1c - 24, centro, Montería, Córdoba
            <a href="https://www.google.com/maps/place/Hotel+Sabana+del+Sin%C3%BA/@8.7612577,-75.8854817,17z/data=!4m10!3m9!1s0x8e5a2f715bcdceff:0x5359dc00e2fe10da!5m3!1s2024-12-01!4m1!1i2!8m2!3d8.7612577!4d-75.8829068!16s%2Fg%2F11l5q2hg91?entry=ttu&g_ep=EgoyMDI0MDkyMy4wIKXMDSoASAFQAw%3D%3D"
              target="_blank" rel="noopener noreferrer">Ver mapa</a>
          </div>
          <!--<div class="buttons">
            <button>
              Ver habitaciones
            </button>-->
          </div>
        </div>
      </div>

      <br>
      </div>


    </div>

    <script>
      // Seleccionamos los botones y las secciones
      const generalBtn = document.getElementById('generalBtn');
      const roomsBtn = document.getElementById('roomsBtn');
      const generalSection = document.getElementById('generalSection');
      const roomsSection = document.getElementById('roomsSection');

      // Funciones para mostrar/ocultar secciones
      generalBtn.addEventListener('click', () => {
        generalSection.classList.add('active');
        roomsSection.classList.remove('active');
        generalBtn.classList.add('active');
        roomsBtn.classList.remove('active');
      });

      roomsBtn.addEventListener('click', () => {
        roomsSection.classList.add('active');
        generalSection.classList.remove('active');
        roomsBtn.classList.add('active');
        generalBtn.classList.remove('active');
      });
    </script>
  </body>


  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #fff;
      color: #1C3D5A;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 65%;
      margin: 0 auto;
      padding: 20px 0;

    }

    .tabs {
      display: flex;
      justify-content: flex-start;
      margin-bottom: 20px;
    }


    /* Menú de navegación */
    .nav-tabs {
      display: flex;

      margin-bottom: 20px;
    }

    .nav-tabs button {
      padding: 10px 20px;
      margin-right: 10px;
      background: none;
      border: none;
      cursor: pointer;
      color: #1C3D5A;
      border-bottom: 2px solid transparent;
      transition: border-bottom 0.1s ease;
    }

    .nav-tabs button.active {
      border-bottom: 4px solid #8B4513;
      font-weight: bold;
    }

    .nav-tabs button:hover {
      border-bottom: 2px solid #8B4513;
    }

    /* Secciones ocultables */
    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .gallery {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .main-image {
      width: 60%;
      height: auto;
      padding-bottom: 20px;

    }

    .side-images {
      width: 38%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;

    }

    .side-images img {
      width: 80%;
      height: auto;
      margin-bottom: 10px;
      border-radius: 5px;

    }

    .description {
      margin-top: 20px;


    }

    .description h2 {
      font-size: 24px;
      margin-bottom: 10px;

    }

    .description p {
      font-size: 16px;
      line-height: 1.5;


    }

    .services {
      margin-top: 20px;

    }

    .services h3 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .services .service-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .services .service-item {
      width: 25%;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
    }

    .services .service-item i {
      margin-right: 10px;
    }

    .services .service-item img {
      margin-right: 10px;
      height: 25px;
      width: 25px;
    }

    .footer {
      margin-top: 20px;
      padding: 20px 0;
      border-top: 1px solid #444;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer .contact-info {
      display: flex;
      align-items: center;
    }

    .footer .contact-info i {
      margin-right: 10px;
    }

    .footer .buttons {
      display: flex;
    }

    .footer .buttons button {
      background-color: #fff;
      color: #1C3D5A;
      padding: 10px 20px;
      margin-left: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .info-box {
      background-color: #f0f0f0;
      padding: 20px;
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 5px;
    }

    .info-box .contact-info {
      display: flex;
      align-items: center;
    }

    .info-box .contact-info i {
      margin-right: 10px;
    }

    .info-box .contact-info a {
      color: #1C3D5A;
      text-decoration: none;
      margin-left: 10px;
    }

    .info-box .buttons {
      display: flex;
    }

    .info-box .buttons button {
      background-color: #1C3D5A;
      color: #fff;
      padding: 10px 20px;
      margin-left: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }


    .highlighted-services,
    .general-services {
      margin-bottom: 20px;
    }

    .highlighted-services img {
      width: 50px;
      margin-right: 10px;
    }

    .highlighted-services {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .general-services ul {
      list-style-type: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .general-services ul li {
      width: 45%;
      margin-bottom: 10px;
    }

    /* Botones en la parte inferior */
    .bottom-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
    }

    .bottom-buttons button {
      background-color: #007BFF;
      color: white;
      padding: 10px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .bottom-buttons button:hover {
      background-color: #0056b3;
    }

    .bottom-buttons a {
      text-decoration: none;
      color: white;
    }




    .search-form-wrapper {
      background-color: #1C3D5A;
      padding: 20px;
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
    }

    .dropdownSearchContainer {
      display: flex;
      align-items: center;
      gap: 1rem;
      background-color: #F29C38;
      /* Cambia el color del fondo */
      border-radius: 8px;
    }

    hr {
      height: auto;
      width: 100%;
      opacity: 0.5;

    }

    .room h3 {
      padding: 20px;
    }



    .room p {
      padding-left: 20px;
      padding-bottom: 8px;
      padding-top: 8px
    }

    .room {
      margin-bottom: 30px;
      border: 1px solid #eaeaea;
      border-radius: 10px;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      background-color: #f5f5f5;
    }

    .room-header {
      display: flex;
    }

    .room-gallery {
      width: 40%;
    }

    .room-main-image-container {
      margin-bottom: 10px;
      padding-right: 20px;
    }

    .room-main-image {
      width: 100%;
      border-radius: 1px;

    }

    .room-small-images-container {
      display: flex;
      justify-content: space-between;
      padding-right: 20px;
    }

    .room-small-image {
      width: 49%;
      border-radius: 1px;
    }

    .room-details {
      width: 55%;
    }

    .room-icons {
      padding-left: 20px;
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 16px;
    }

    .room-icons span {
      display: flex;
      align-items: center;
    }

    .room h4 {
      padding-left: 20px;
    }

    .room-services ul {
      list-style-type: none;
      padding-left: 20px;
      padding-top: 13px;
      display: flex;
      flex-wrap: wrap;
    }

    .room-services ul li {
      padding-left: 20px;
      padding-top: 20px;
      width: 45%;
      margin-bottom: 5px;
    }

    .availability-button {
      margin-top: 10px;
      padding: 20px 20px;
      background-color: #033f97;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
  </style>