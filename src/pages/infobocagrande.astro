  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #fff;
      color: #1C3D5A;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 65%;
      margin: 0 auto;
      padding: 20px 0;

    }

    .tabs {
      display: flex;
      justify-content: flex-start;
      margin-bottom: 20px;
    }


    /* Menú de navegación */
    .nav-tabs {
      display: flex;

      margin-bottom: 20px;
    }

    .nav-tabs button {
      padding: 10px 20px;
      margin-right: 10px;
      background: none;
      border: none;
      cursor: pointer;
      color: #1C3D5A;
      border-bottom: 2px solid transparent;
      transition: border-bottom 0.1s ease;
    }

    .nav-tabs button.active {
      border-bottom: 4px solid #8B4513;
      font-weight: bold;
    }

    .nav-tabs button:hover {
      border-bottom: 2px solid #8B4513;
    }

    /* Secciones ocultables */
    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .gallery {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .main-image {
      width: 60%;
      height: auto;
      padding-bottom: 20px;

    }

    .side-images {
      width: 38%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;

    }

    .side-images img {
      width: 100%;
      height: auto;
      margin-bottom: 10px;
      border-radius: 5px;

    }

    .description {
      margin-top: 20px;


    }

    .description h2 {
      font-size: 24px;
      margin-bottom: 10px;

    }

    .description p {
      font-size: 16px;
      line-height: 1.5;


    }

    .services {
      margin-top: 20px;

    }

    .services h3 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .services .service-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .services .service-item {
      width: 25%;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
    }

    .services .service-item i {
      margin-right: 10px;
    }
    .services .service-item img {
      margin-right: 10px;
      height: 25px;
      width: 25px;
    }

    .footer {
      margin-top: 20px;
      padding: 20px 0;
