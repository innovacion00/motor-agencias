---
import BaseLayout from "../layouts/BaseLayout.astro";
import DropdownSearch from "../components/DropdownSearch";
import DisponibilidadVuelos from "../components/DisponibilidadVuelos";
import CurrencySelector from '../components/Cambiardivisas';
---

<BaseLayout title="Selección de Vuelos - BookingConnect">
    <DropdownSearch client:load />
  <div class="container">
    <DisponibilidadVuelos client:only="react" />
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  :global(body) {
    font-family: 'Roboto', sans-serif;
    background-color: #f5f5f5;
    margin: 0;
  }


</style>

<script>
  function checkAuth() {
    const token = localStorage.getItem("authToken");
    if (!token) {
      window.location.href = "/login";
    }
  }
  checkAuth();
</script>